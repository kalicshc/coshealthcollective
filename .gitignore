# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# dashboard is its own repo (github.com:kalicshc/clinic-platform-dashboard)
/dashboard

# stray local screenshots / scratch images at repo root
/Pikes Peak at Sunset Through Fog.png

# generated print artifacts (PDFs/PNGs from scripts/export-*.mjs)
/print-exports/
